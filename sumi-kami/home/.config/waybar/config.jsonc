// Sumi kami bar, identical on every monitor (no "output" key).
//   left   workspace slots of *this* monitor (custom/ws-*, fed by
//          ~/.local/bin/hattin-workspaces; clicks go through hattin_ws in
//          hypr/workspaces.lua because Hyprland's Lua config rejects the
//          legacy dispatch the hyprland/workspaces module sends), then the
//          next prayer (custom/mawaqit, ~/.local/bin/waybar-mawaqit over the
//          mawaqit-api podman quadlet; mosques in ~/.config/mawaqit/mosques,
//          scroll or right-click to switch)
//          and the focused window title
//   centre date and time (the middle stroke)
//   right  instrument cluster; NET, SYS and ◌ expand on click; yawm is
//          Taskwarrior due today (click list, right-click quick add,
//          ~/.local/bin/sumi-yawm; refreshed on SIGRTMIN+10)
// The brush strokes and colours live in style.css.
// IDLE (custom/idle, ~/.local/bin/hattin-idle, refreshed on SIGRTMIN+11) switches the
// idle actions off and on: the idle lock of hypr/hypridle.conf and any logind
// IdleAction (hibernate, logout). Off = a systemd idle inhibitor; class .off.
{
  "name": "hattin-bar",
  "layer": "top",
  "position": "top",
  "height": 42,
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 0,
  "modules-left": [
    "group/workspaces",
    "custom/mawaqit",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/net",
    "group/sys",
    "wireplumber",
    "battery",
    "group/extras",
    "custom/notifications",
    "custom/idle",
    "custom/yawm"
  ],
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/ws-1",
      "custom/ws-2",
      "custom/ws-3",
      "custom/ws-4",
      "custom/ws-5",
      "custom/ws-6",
      "custom/ws-7",
      "custom/ws-8",
      "custom/ws-9",
      "custom/ws-10",
      "custom/ws-x"
    ]
  },
  "custom/ws-1": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/1\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(1)'"
  },
  "custom/ws-2": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/2\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(2)'"
  },
  "custom/ws-3": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/3\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(3)'"
  },
  "custom/ws-4": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/4\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(4)'"
  },
  "custom/ws-5": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/5\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(5)'"
  },
  "custom/ws-6": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/6\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(6)'"
  },
  "custom/ws-7": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/7\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(7)'"
  },
  "custom/ws-8": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/8\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(8)'"
  },
  "custom/ws-9": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/9\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(9)'"
  },
  "custom/ws-10": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/10\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.click(10)'"
  },
  "custom/ws-x": {
    "exec": "cat \"$XDG_RUNTIME_DIR/hattin-ws/$WAYBAR_OUTPUT_NAME/x\" 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "format": "{}",
    "on-click": "hyprctl eval 'hattin_ws.cycle_foreign()'"
  },
  "custom/mawaqit": {
    "exec": "~/.local/bin/waybar-mawaqit",
    "return-type": "json",
    "interval": 20,
    "signal": 9,
    "format": "{}",
    "on-click": "~/.local/bin/waybar-mawaqit open",
    "on-click-right": "~/.local/bin/waybar-mawaqit next",
    "on-scroll-up": "~/.local/bin/waybar-mawaqit prev",
    "on-scroll-down": "~/.local/bin/waybar-mawaqit next",
    "smooth-scrolling-threshold": 1.5
  },
  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true,
    "max-length": 40
  },
  "group/net": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 250,
      "transition-left-to-right": false,
      "children-class": "drawer-hidden"
    },
    "modules": [
      "network",
      "custom/proton",
      "custom/tailscale",
      "bluetooth"
    ]
  },
  "group/sys": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 250,
      "transition-left-to-right": false,
      "children-class": "drawer-hidden"
    },
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "custom/nvidia",
      "power-profiles-daemon"
    ]
  },
  "group/extras": {
    "orientation": "inherit",
    "drawer": {
      "click-to-reveal": true,
      "transition-duration": 250,
      "transition-left-to-right": false,
      "children-class": "drawer-hidden"
    },
    "modules": [
      "custom/tray-leader",
      "tray"
    ]
  },
  "network": {
    "format-ethernet": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>NET</span> eth <span color='#A39B8C'>‹</span>",
    "format-wifi": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>NET</span> {signalStrength}% <span color='#A39B8C'>‹</span>",
    "format-disconnected": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>NET</span> off <span color='#A39B8C'>‹</span>",
    "tooltip-format": "{ifname}  {ipaddr}\n{essid}"
  },
  "custom/proton": {
    "exec": "~/.local/bin/waybar-proton",
    "return-type": "json",
    "interval": 10
  },
  "custom/tailscale": {
    "exec": "~/.local/bin/waybar-tailscale",
    "return-type": "json",
    "interval": 15
  },
  "bluetooth": {
    "format": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>BT</span> on",
    "format-disabled": "",
    "format-off": ""
  },
  "cpu": {
    "format": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>SYS</span> {usage:>2}% <span color='#3A3733'>{icon}</span> <span color='#A39B8C'>‹</span>",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
    "tooltip": false
  },
  "memory": {
    "format": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>MEM</span> {used:0.1f}G <span color='#3A3733'>{icon}</span>",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ]
  },
  "temperature": {
    "critical-threshold": 90,
    "format": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>TMP</span> {temperatureC}°"
  },
  "custom/nvidia": {
    "exec": "~/.local/bin/waybar-nvidia",
    "return-type": "json",
    "interval": 30
  },
  "power-profiles-daemon": {
    "format": "{profile}",
    "tooltip": true
  },
  "wireplumber": {
    "format": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>VOL</span> {volume}%",
    "format-muted": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>VOL</span> mute",
    "on-click": "pavucontrol"
  },
  "battery": {
    "format": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>BAT</span> {capacity}%",
    "format-charging": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>BAT</span> +{capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "custom/tray-leader": {
    "format": "◌",
    "tooltip-format": "Tray"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 7
  },
  "custom/notifications": {
    "format": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>NOTIF</span>",
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d"
  },
  "custom/idle": {
    "exec": "~/.local/bin/hattin-idle",
    "return-type": "json",
    "interval": 30,
    "signal": 11,
    "format": "<span color='#66615A' font_family='Instrument Sans' weight='600' size='small' letter_spacing='1500'>IDLE</span> {}",
    "on-click": "~/.local/bin/hattin-idle toggle"
  },
  "custom/yawm": {
    "exec": "~/.local/bin/waybar-yawm",
    "return-type": "json",
    "interval": 300,
    "signal": 10,
    "on-click": "~/.local/bin/sumi-yawm",
    "on-click-right": "~/.local/bin/sumi-yawm add"
  },
  "clock": {
    "locale": "en_GB.UTF-8",
    "format": "<span color='#A39B8C'>·</span>   <span color='#66615A'>{0:%a %d %b}</span>   {0:%H:%M}   <span color='#A39B8C'>·</span>",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "today": "<span background='#E4E0D8' color='#16140F'><span color='#C8412B'>▎</span>{}</span>",
        "weekdays": "<span color='#66615A'>{}</span>"
      }
    }
  }
}
