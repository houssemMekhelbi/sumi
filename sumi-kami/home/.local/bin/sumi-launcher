#!/usr/bin/env bash
# Sumi launcher: a floating foot window running fzf over desktop entries.
# Hyprland gives it the paper frame and shadow (see hypr/sumi-kami.lua); foot
# requests the blur through ext-background-effect.
# Pressing the bind again while it is open closes it.
set -euo pipefail

if hyprctl clients -j | grep -q '"class": "sumi-launcher"'; then
    hyprctl eval 'sumi_close_launcher()' >/dev/null
    exit 0
fi

exec foot \
    --app-id=sumi-launcher \
    --title=Launcher \
    -o main.pad=18x14 \
    -o main.font="DM Mono:size=10.5" \
    -o main.line-height=22 \
    -o colors-dark.alpha=0.96 \
    -o colors-light.alpha=0.96 \
    "$HOME/.local/bin/sumi-launcher-menu"
