# Taskwarrior. Shown in waybar as "yawm" (~/.local/bin/waybar-yawm):
#   click        list popup   (~/.local/bin/sumi-yawm -> sumi-yawm-menu)
#   right-click  quick add    (~/.local/bin/sumi-yawm add)
# Tasks tagged +note are notes: listed last, never counted in the bar.

data.location=~/.local/share/task
news.version=3.5.0
editor=nvim
weekstart=monday

# Sumi yoru colours (256-colour approximations): overdue in seal red,
# due today in bold ink, notes in indigo.
color.due.today=bold gray23
color.due=gray16
color.overdue=bold rgb411
color.tag.note=rgb134
color.active=rgb134
color.header=gray14
color.label=gray14
color.footnote=gray10
