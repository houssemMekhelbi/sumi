#!/bin/sh

if ! command -v tailscale >/dev/null 2>&1; then
    printf '{"text":"","class":"off"}\n'
    exit 0
fi

state="$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "Unknown"')"

case "$state" in
    Running)
        printf '{"text":"TS","class":"up","tooltip":"Tailscale connected"}\n'
        ;;
    *)
        printf '{"text":"TS off","class":"down","tooltip":"Tailscale: %s"}\n' "$state"
        ;;
esac
